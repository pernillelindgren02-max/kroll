# Use the SAME Supabase project as Fra gryte til gaffel
# (Project Settings → API → Project URL + publishable/anon key).
# Copy the same values you already use in the FGTG app's .env.local.
# Then restart Vite from the kroll/ folder.
#
# Netlify (production): set the SAME two names under
# Site settings → Environment variables, then trigger a new deploy.
# Vite only reads VITE_* at build time.
#
# Shared: Auth users + profiles (is_admin, preferred_locale, …)
# Krøll-only tables: see supabase/kroll-schema.sql
#
# Never commit real keys. This file is an example only.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
